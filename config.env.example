# ==============================================================================
# Pipeline Configuration Override Template (config.env.example)
# Copy to config.env to override defaults for production runs:
#   cp config.env.example config.env
# ==============================================================================

# Input and Output Directories
RAW_DIR="data/raw"
CLEAN_DIR="data/clean"
ALIGNED_DIR="data/aligned"
COUNTS_DIR="data/counts"
REPORTS_DIR="reports"

# Reference Genome Paths (Provide your real genome and annotation)
GENOME_FASTA="data/reference/genome.fa"
GTF_FILE="data/reference/genes.gtf"
STAR_INDEX="data/reference/star_index"

# Hardware Resources
THREADS=8
STAR_RAM_LIMIT=31000000000  # 31 GB for mammalian genomes (human/mouse)

# Quality Trimming (fastp)
MIN_READ_LENGTH=35
MIN_QUALITY=20
MAX_UNQUALIFIED_PCT=30
ADAPTER_FWD="CTGTCTCTTATACACATCT"  # Nextera adapter for Smart-seq2 (or "auto")
ADAPTER_REV="CTGTCTCTTATACACATCT"

# Quantification (featureCounts)
STRANDEDNESS=0           # 0 = unstranded (Smart-seq2), 1 = stranded, 2 = reverse
FEATURE_TYPE="exon"
ATTRIBUTE_TYPE="gene_id"
MIN_MAPQ=10
