/*
========================================================================================
   Nextflow DSL2 Production Configuration: Smart-seq2 Upstream Pipeline
========================================================================================
*/

params {
    // Input/Output Options
    help                = false
    input               = "samplesheet.csv"     // Path to samplesheet.csv (sample,fastq_1,fastq_2)
    sample_sheet        = null                  // Alias for input
    samplesheet         = null                  // Alias for input
    reads               = "data/raw/*.fastq.gz" // Glob pattern if running directly from FASTQ directory
    outdir              = "results"
    single_end          = true                  // Single-End layout (Segerstolpe et al. Smart-seq2)
    interactive_plots   = false                 // MultiQC interactive plots (false avoids browser freeze on large cohorts)

    // Reference Genome Options (Homo sapiens GRCh38)
    fasta               = "data/reference/genome.fa"
    gtf                 = "data/reference/genes.gtf"
    star_index          = "data/reference/star_index"

    // Library & Trimming Thresholds
    // Smart-seq2 Nextera XT adapter (explicitly provided for Single-End mode)
    adapter_r1          = "CTGTCTCTTATACACATCT"
    adapter_r2          = "CTGTCTCTTATACACATCT"
    min_quality         = 20
    min_length          = 25                    // 25 bp: adjusted for 43 bp short reads (HiSeq 2000)
    strandedness        = 0                     // 0 = unstranded (Smart-seq2), 1 = stranded, 2 = reverse

    star_sort_ram       = 31000000000           // ~31 GB sort buffer for human genome

    // Resource Defaults
    threads             = 8
}

// Inherit local environment PATH when running without containers
env {
    PATH = "${projectDir}/../.pixi/envs/default/bin:${System.getenv('PATH') ?: ''}"
}

// Production Process Resource Labels & Container Directives
process {
    // Dynamic error handling and memory scaling
    errorStrategy = { task.exitStatus in [140,143,137] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_single {
        cpus = 1
        memory = 2.GB
        time = 1.h
    }
    // Default label allocations
    withLabel: process_low {
        cpus   = { Math.min(2, params.threads as int) }
        memory = 6.GB
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = { Math.min(6, params.threads as int) }
        memory = 16.GB
        time   = 6.h
    }
    withLabel: process_high {
        cpus   = { Math.min(12, params.threads as int) }
        memory = 36.GB
        time   = 12.h
    }

    // Process BioContainers for complete portability
    withName: 'FASTQC.*' {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }
    withName: 'FASTP' {
        container = 'quay.io/biocontainers/fastp:0.23.4--hadf994f_2'
    }
    withName: 'STAR_ALIGN' {
        container = 'quay.io/biocontainers/mulled-v2-1fa26d1ce03c295fe2fdcfabb74b59c33b100cde:5e4eac646962f9f1092500057be03cd29ff70a59-0'
    }
    withName: 'FEATURECOUNTS' {
        container = 'quay.io/biocontainers/subread:2.0.6--he4a0461_0'
    }
    withName: 'MULTIQC' {
        container = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }
}

// Execution Profiles
profiles {
    local {
        process.executor = 'local'
    }


    docker {
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }
}

// Pipeline Reporting
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
