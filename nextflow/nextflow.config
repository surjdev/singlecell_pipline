/*
========================================================================================
   Nextflow DSL2 Production Configuration: Smart-seq2 Upstream Pipeline
========================================================================================
*/

params {
    // Input/Output Options
    input               = null                  // Path to samplesheet.csv (sample,fastq_1,fastq_2,strandedness)
    reads               = "data/raw/*_R{1,2}*.fastq.gz" // Alternative glob pattern if no samplesheet
    outdir              = "results"

    // Reference Genome Options (Required for real runs)
    fasta               = null                  // e.g. "data/reference/genome.fa"
    gtf                 = null                  // e.g. "data/reference/genes.gtf"
    star_index          = null                  // e.g. "data/reference/star_index"

    // Library & Trimming Thresholds
    adapter_r1          = "auto"                // "auto" or custom sequence (e.g. Nextera CTGTCTCTTATACACATCT)
    adapter_r2          = "auto"
    min_quality         = 20
    min_length          = 35                    // Standard production minimum length (bp)
    strandedness        = 0                     // 0 = unstranded (Smart-seq2), 1 = stranded, 2 = reverse

    // Resource Defaults
    threads             = 4
    max_memory          = 64.GB
    max_cpus            = 16
    max_time            = 24.h
}

// Inherit local environment PATH when running without containers
env {
    PATH = "${projectDir}/../.pixi/envs/default/bin:${System.getenv('PATH') ?: ''}"
}

// Production Process Resource Labels & Container Directives
process {
    // Dynamic error handling and memory scaling
    errorStrategy = { task.exitStatus in [140,143,137] ? 'retry' : 'finish' }
    maxRetries    = 2

    // Default label allocations
    withLabel: process_low {
        cpus   = 2
        memory = 6.GB
        time   = 2.h
    }
    withLabel: process_medium {
        cpus   = 6
        memory = 16.GB
        time   = 6.h
    }
    withLabel: process_high {
        cpus   = 12
        memory = 36.GB
        time   = 12.h
    }

    // Process BioContainers for complete portability
    withName: 'FASTQC.*' {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }
    withName: 'FASTP' {
        container = 'quay.io/biocontainers/fastp:0.23.4--hadf994f_2'
    }
    withName: 'STAR_ALIGN' {
        container = 'quay.io/biocontainers/mulled-v2-1fa26d1ce03c295fe2fdcfabb74b59c33b100cde:5e4eac646962f9f1092500057be03cd29ff70a59-0'
    }
    withName: 'FEATURECOUNTS' {
        container = 'quay.io/biocontainers/subread:2.0.6--he4a0461_0'
    }
    withName: 'MULTIQC' {
        container = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }
}

// Execution Profiles
profiles {
    local {
        process.executor = 'local'
    }

    conda {
        process.executor = 'local'
        conda.enabled    = true
    }

    docker {
        docker.enabled   = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }
}

// Pipeline Reporting
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.html"
}
