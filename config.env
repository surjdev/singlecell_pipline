# ==============================================================================
# Pipeline Configuration for Smart-seq2 Single-Cell RNA-seq (config.env)
# Tailored for: Segerstolpe et al. 2016 Human Pancreatic Islets (E-MTAB-5061)
# Sequencing: Illumina HiSeq 2000, 43 bp Single-End reads
# ==============================================================================

# 1. Input and Output Directories
RAW_DIR="data/raw"
CLEAN_DIR="data/clean"
ALIGNED_DIR="data/aligned"
COUNTS_DIR="data/counts"
REPORTS_DIR="reports"

# 2. Reference Genome Paths (Homo sapiens GRCh38)
GENOME_FASTA="data/reference/genome.fa"
GTF_FILE="data/reference/genes.gtf"
STAR_INDEX="data/reference/star_index"

# 3. Hardware Resources
THREADS=8
STAR_RAM_LIMIT=31000000000  # ~31 GB sorting buffer for human GRCh38 genome

# 4. Trimming & Quality Thresholds (fastp)
# Adjusted to 25 bp: Raw reads are only 43 bp (HiSeq 2000). A threshold of 35 bp
# would discard >60% of valid reads after trimming poly-A/G/X and adapters!
MIN_READ_LENGTH=25
MIN_QUALITY=20
MAX_UNQUALIFIED_PCT=30

# Smart-seq2 standard adapter (Nextera XT transposase)
# Explicit sequence required for Single-End reads where read-overlap auto-detection is unavailable
ADAPTER_FWD="CTGTCTCTTATACACATCT"
ADAPTER_REV="CTGTCTCTTATACACATCT"

# 5. Quantification Options (featureCounts)
# Smart-seq2 cDNA synthesis (oligo-dT + TSO) yields unstranded libraries (0 = unstranded)
STRANDEDNESS=0
FEATURE_TYPE="exon"
ATTRIBUTE_TYPE="gene_id"
MIN_MAPQ=10
